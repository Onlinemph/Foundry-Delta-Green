"halve_dodge"
]
},
{
"state":"Dying #2",
"value":"Math.round(-$hp * 2)",
"ops":[
"halve_move",
"halve_dodge"
]
},
{
"state":"Dying #1",
"value":"-$hp",
"ops":[
"halve_move",
"halve_dodge"
]
},
{
"state":"Collapse",
"value":"0",
"ops":[
"halve_move",
"halve_dodge"
]
},
{
"state":"Reeling",
"value":"Math.ceil($hp / 3) - 1",
"ops":[
"halve_move",
"halve_dodge"
]
},
{
"state":"Wounded",
"value":"$hp - 1"
},
{
"state":"Healthy",
"value":"$hp"
}
]
}
