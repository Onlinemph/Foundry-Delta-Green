   {
    "id": "fp",
    "type": "pool",
    "name": "FP",
    "full_name": "Fatigue Points",
    "base": "$ht",
    "cost_per_point": 3,
    "thresholds": [
     {
      "state": "Unconscious",
      "value": "-$fp",
      "ops": [
       "halve_move",
       "halve_dodge",
       "halve_st"
      ]
     },
     {
      "state": "Collapse",
      "value": "0",
      "ops": [
       "halve_move",
       "halve_dodge",
       "halve_st"
      ]
     },
     {
      "state": "Tired",
      "value": "Math.ceil($fp / 3) - 1",
      "ops": [
       "halve_move",
       "halve_dodge",
       "halve_st"
      ]
     },
     {
      "state": "Tiring",
      "value": "$fp - 1"
     },
     {
      "state": "Rested",
      "value": "$fp"
     }
    ]
   },
   {
    "id": "hp",
    "type": "pool",
    "name": "HP",
    "full_name": "Hit Points",
    "base": "$st",
    "cost_per_point": 2,
    "cost_adj_percent_per_sm": 10,
    "thresholds": [
     {
      "state": "Dead",
      "value": "Math.round(-$hp * 5)",
      "ops": [
