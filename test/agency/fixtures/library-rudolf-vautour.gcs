{
"id":"EE6Hd9qGxeHRRxnqQ",
"description":"Heavy Warhorse",
"local_notes":"<script>\nconst st = 26;\nconst dx = 9;\nconst iq = 3;\nconst ht = 12;\nconst bl = Math.round((st * st) / 5);\nconst carried = self.extendedWeight - self.weight;\nlet move = Math.floor((dx + ht) / 4) + 2;\nlet enc = \"\";\nif (carried <= bl) {\n  enc = \"No\";\n} else if (carried <= bl * 2) {\n  enc = \"Light\";\n  move = Math.floor(move * 0.8);\n} else if (carried <= bl * 3) {\n  enc = \"Medium\";\n  move = Math.floor(move * 0.6);\n} else {\n  enc = \"**Overloaded!**\";\n}\n\"ST \" + st + \", DX \" + dx + \", IQ \" + iq + \", HT \" + ht + \"<br>\" + (enc.startsWith(\"**\") ? enc : enc + \" Encumbrance<br>Move \" + move + \"; Enhanced Move \" + (move * 2));\n</script>",
"base_value":"// Currently only accounts for changes in ST\nlet stMatch = self.notes.match(/ST (\\d+)/i);\nconst st = stMatch.length > 1 ? stMatch[1] : 24;\nMath.round(5000 * ((st - 10) / 14))",
